{
  "name": "agency-manager",
  "version": "1.0.0",
  "description": "D-GROW OS — Agency Task & Project Management System",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npm --prefix server run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test:server": "npm --prefix server test",
    "bootstrap:owner": "npm --prefix server run bootstrap:owner",
    "postinstall": "npm --prefix server install"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^10.1.0",
    "socket.io": "^4.8.4",
    "zod": "^3.23.8"
  }
}
